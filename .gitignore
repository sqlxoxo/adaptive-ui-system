#   For a library or package, you might want to ignore these files since the next user
#   might have a different setup.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if users have different platform/python version, inside may fail.
# Pipfile.lock

# poetry
#   Similarly, poetry.lock is usually committed, but virtualenv should be ignored.
.venv/
venv/
